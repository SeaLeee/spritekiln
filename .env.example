# SpriteKiln environment template.
# Copy to .env (same folder as README.md) and edit. Existing process env wins over .env.
# Never commit the real .env — it is gitignored.

# ------------------------------------------------------------------ runtime
# Where SQLite, generated assets and settings.json live. Default: ./data
# SPRITEKILN_DATA=./data

# ------------------------------------------------------------------ local ComfyUI
# The ComfyUI API endpoint. Start ComfyUI first (tools/start_comfyui.ps1 or your own launcher).
# SPRITEKILN_COMFYUI_URL=http://127.0.0.1:8188

# ------------------------------------------------------------------ local LLM (Agent planner)
# Any OpenAI-compatible endpoint: Ollama (default), LM Studio, vLLM, llama.cpp server…
# Ollama:   ollama pull deepseek-r1:8b
# LM Studio: start the local server (default http://127.0.0.1:1234/v1)
# SPRITEKILN_LLM_URL=http://127.0.0.1:11434/v1
# SPRITEKILN_LLM_KEY=ollama
# SPRITEKILN_LLM_MODEL=deepseek-r1:8b

# ------------------------------------------------------------------ local 3D (Pixal3D)
# Optional. Leave empty to disable; the 3D route then falls back to a billboard/mock model.
# SPRITEKILN_PIXAL3D_REPO=D:/AI/Pixal3D
# SPRITEKILN_PIXAL3D_PYTHON=D:/AI/Pixal3D/.venv/Scripts/python.exe

# ------------------------------------------------------------------ helper scripts only
# Used by tools/start_comfyui.ps1 and tools/fix_pixal3d.ps1. Not read by the server.
# COMFYUI_DIR=D:/AI/ComfyUI
# PIXAL3D_DIR=D:/AI/Pixal3D

# ------------------------------------------------------------------ cloud API keys
# Cloud providers are configured in the web UI (设置 → 模型服务) and stored in
# data/settings.json (masked in the browser). Keep keys out of this file unless you
# prefer environment-driven deployment; the defaults above read only the LLM variables.
